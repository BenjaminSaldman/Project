        "def hist_shape(img_src: np.array, img_dest: np.array) -> np.array:\n",
        "\n",
        "    hist_src = np.zeros(256, dtype=np.int64)\n",
        "    hist_dest = np.zeros(256, dtype=np.int64)\n",
        "\n",
        "    h_src, w_src = img_src.shape\n",
        "    h_dest, w_dest = img_dest.shape\n",
        "\n",
        "    for i in range(h_src):\n",
        "        for j in range(w_src):\n",
        "            v_s = int(img_src[i, j])\n",
        "            if v_s < 0:\n",
        "                v_s = 0\n",
        "            elif v_s > 255:\n",
        "                v_s = 255\n",
        "            hist_src[v_s] += 1\n",
        "\n",
        "    for i in range(h_dest):\n",
        "        for j in range(w_dest):\n",
        "            v_d = int(img_dest[i, j])\n",
        "            if v_d < 0:\n",
        "                v_d = 0\n",
        "            elif v_d > 255:\n",
        "                v_d = 255\n",
        "            hist_dest[v_d] += 1\n",
        "\n",
        "    cdf_src = np.zeros(256, dtype=np.float64)\n",
        "    cdf_dest = np.zeros(256, dtype=np.float64)\n",
        "\n",
        "    cdf_src[0] = hist_src[0]\n",
        "    cdf_dest[0] = hist_dest[0]\n",
        "\n",
        "    for k in range(1, 256):\n",
        "        cdf_src[k] = cdf_src[k-1] + hist_src[k]\n",
        "        cdf_dest[k] = cdf_dest[k-1] + hist_dest[k]\n",
        "\n",
        "    cdf_src /= cdf_src[-1]\n",
        "    cdf_dest /= cdf_dest[-1]\n",
        "\n",
        "    mapping = np.zeros(256, dtype=np.uint8)\n",
        "\n",
        "    for g in range(256):\n",
        "        diff = np.abs(cdf_src[g] - cdf_dest)\n",
        "        mapping[g] = np.argmin(diff)\n",
        "\n",
        "    img_new = np.zeros_like(img_src)\n",
        "\n",
        "    for i in range(h_src):\n",
        "        for j in range(w_src):\n",
        "            v = int(img_src[i, j])\n",
        "            if v < 0:\n",
        "                v = 0\n",
        "            elif v > 255:\n",
        "                v = 255\n",
        "            img_new[i, j] = mapping[v]\n",
        "\n",
        "    return img_new\n"
      ],
      "metadata": {
