    {
      "cell_type": "code",
      "source": [
        "def create_tiled_image(img_big: np.array, img_small: np.array) -> np.array:\n",
        "\n",
        "    h_big, w_big = img_big.shape\n",
        "    h_small, w_small = img_small.shape\n",
        "\n",
        "    img_new = np.zeros_like(img_big)\n",
        "\n",
        "    for i in range(0, h_big, h_small):\n",
        "        for j in range(0, w_big, w_small):\n",
        "\n",
        "            block = img_big[i:i+h_small, j:j+w_small]\n",
        "\n",
        "            if block.shape != img_small.shape:\n",
        "                continue\n",
        "\n",
        "            tile = hist_shape(img_small, block)\n",
        "\n",
        "            img_new[i:i+h_small, j:j+w_small] = tile\n",
        "\n",
        "    return img_new\n"
      ],
