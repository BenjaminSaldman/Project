{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "default": {
      "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
    }
  },
  "handlers": {
    "debug_handler": {
      "class": "configuration.size_timed_rotating_file_handler.SizeTimedRotatingFileHandler",
      "filename": "logs/debug_handler.log",
      "formatter": "default",
      "when": "midnight",
      "interval": 1,
      "backupCount": 7,
      "encoding": "utf-8"
    }
  },
  "loggers": {
    "": {
      "level": "DEBUG",
      "handlers": ["debug_handler"],
      "propagate": false
    }
  }
}
